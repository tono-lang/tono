func (c *Client) SaveNote(ctx context.Context, input Note) (Note, error) {
	var zero Note
	record, err := record.EncodeRecord(input)
	if err != nil {
		return zero, err
	}

	requestURL := c.settings.Endpoint + "/notes/" + transport.PathPart(record["id"])

	headers := map[string]string{}
	transport.SetHeader(headers, "X-Client-Name", c.settings.ClientName)
	for name, value := range c.settings.Headers {
		transport.SetHeader(headers, name, value)
	}

	var body []byte
	if v, ok := record["body"]; ok {
		encoded, err := json.Marshal(v)
		if err != nil {
			return zero, err
		}
		body = encoded
	}
	if body != nil && !transport.HasHeader(headers, "content-type") {
		headers["content-type"] = "application/json"
	}

	outcome := transport.Send(ctx, c.settings.HTTPClient, c.settings.Transport, transport.Request{
		Method: "POST",
		URL: requestURL,
		Headers: headers,
		Body: body,
		Timeout: c.timeoutDuration,
		Success: []int{200},
		Timing: c.timing,
		Retry: transport.Retry{Max: int(c.settings.MaxRetries), When: func(status int, body string) bool {
			if re, ok := DecodeSaveNoteError(status, []byte(body)).(interface{ Retryable() bool }); ok {
				return re.Retryable()
			}
			return false
		}},
	})
	if outcome.Cause != nil {
		return zero, &TransportError{Cause: outcome.Cause}
	}

	if outcome.Status == 200 {
		out, path, ok := DecodeNote([]byte(outcome.Body))
		if !ok {
			return zero, &DecodeError{Path: path, Expected: "Note", Raw: outcome.Body}
		}
		return out, nil
	}

	return zero, DecodeSaveNoteError(outcome.Status, []byte(outcome.Body))
}

func DecodeSaveNoteError(status int, body []byte) error {
	var probe struct {
		Code string `json:"code"`
	}
	// A body that fails to unmarshal leaves probe zeroed: no guard below
	// matches, and the fallback carries the raw body as APIError.
	_ = json.Unmarshal(body, &probe)
	if status == statusOverloaded && probe.Code == codeOverloaded {
		var data Overloaded
		if json.Unmarshal(body, &data) == nil {
			return &data
		}
	}
	return &APIError{Status: status, Body: string(body)}
}

