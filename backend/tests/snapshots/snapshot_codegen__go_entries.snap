package record
import "encoding/json"

// EncodeRecord turns a typed input into the wire record the request
// positions bind from, through the type's own JSON tags.
func EncodeRecord(v any) (map[string]any, error) {
	b, err := json.Marshal(v)
	if err != nil {
		return nil, err
	}
	var m map[string]any
	if err := json.Unmarshal(b, &m); err != nil {
		return nil, err
	}
	return m, nil
}

// ==== go/internal/casing/casing.go ====
// Code generated by tono. DO NOT EDIT.

package casing
import "strings"

// StrTransformWords splits a resolved value for the casing transforms:
// runs of spaces, hyphens, and underscores separate words.
func StrTransformWords(s string) []string {
	return strings.FieldsFunc(s, func(r rune) bool { return r == ' ' || r == '-' || r == '_' })
}

func StrUpperSnake(s string) string {
	ws := StrTransformWords(s)
	for i := range ws {
		ws[i] = strings.ToUpper(ws[i])
	}
	return strings.Join(ws, "_")
}

