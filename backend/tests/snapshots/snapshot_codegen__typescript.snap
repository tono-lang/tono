export function decodeCreateChargeError(status: number, body: string): TonoError {
  let parsed: any;
  try {
    // A body that fails to parse falls straight to the fallback, which
    // carries the raw body as APIError.
    parsed = JSON.parse(body);
  } catch {
    return new APIError(status, body);
  }
  try {
    if (status === STATUS_PAYMENT_DECLINED && parsed?.["code"] === CODE_PAYMENT_DECLINED) {
      return new PaymentDeclinedError(decodePaymentDeclined(parsed), body);
    }
    if (status === STATUS_RATE_LIMITED) {
      return new RateLimitedError(decodeRateLimited(parsed), body);
    }
  } catch {}
  return new APIError(status, body);
}

