export function validateCardData(value: CardData): ValidationError | null {
  const violations: Violation[] = [];
  if ([...value.last4].length < 4) {
    violations.push({ field: "last4", constraint: "length", message: "last4 length must be >= 4" });
  }
  if ([...value.last4].length > 4) {
    violations.push({ field: "last4", constraint: "length", message: "last4 length must be <= 4" });
  }
  return violations.length > 0 ? new ValidationError(violations) : null;
}

