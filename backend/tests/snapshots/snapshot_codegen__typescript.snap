export type Timestamp = string & { readonly __brand: "Timestamp" };

export interface Account {
  accountID: bigint;
  secret: Uint8Array;
  tip?: bigint | null;
  status: Status;
  code: HTTPCode;
  created: Timestamp;
  method: Method;
  counts: [number, string][];
}

export function validateAccount(value: Account): ValidationError | null {
  const violations: Violation[] = [];
  if (value.accountID < 0n) {
    violations.push({ field: "account_id", constraint: "range", message: "account_id must be >= 0" });
  }
  if (value.secret.length > 64) {
    violations.push({ field: "secret", constraint: "length", message: "secret length must be <= 64" });
  }
  if (value.counts.length < 1) {
    violations.push({ field: "counts", constraint: "length", message: "counts length must be >= 1" });
  }
  return violations.length > 0 ? new ValidationError(violations) : null;
}

export type Status = "active" | "closed" | (string & {});

export type HTTPCode = 200 | 404 | 500 | (number & {});

export type Method = ({ type: "card" } & CardData) | ({ type: "bank" } & BankData);

export interface CardData {
  last4: string;
}

export function validateCardData(value: CardData): ValidationError | null {
  const violations: Violation[] = [];
  if ([...value.last4].length < 4) {
    violations.push({ field: "last4", constraint: "length", message: "last4 length must be >= 4" });
  }
  if ([...value.last4].length > 4) {
    violations.push({ field: "last4", constraint: "length", message: "last4 length must be <= 4" });
  }
  return violations.length > 0 ? new ValidationError(violations) : null;
}

export interface BankData {
  iban: string;
  branch?: string | null;
}

export interface PaymentDeclined {
  message: string;
}

export interface RateLimited {
}

export abstract class TonoError extends Error {
  retryable(): boolean {
    return false;
  }
}

export interface Violation {
  field: string;
  constraint: string;
  message: string;
}

export class ValidationError extends TonoError {
  constructor(readonly violations: Violation[]) {
    super("validation failed");
    this.name = "ValidationError";
  }
}

export class APIError extends TonoError {
  constructor(readonly status: number, readonly body: string) {
    super(`api error ${status}`);
    this.name = "APIError";
  }
}

export const STATUS_PAYMENT_DECLINED = 402;

export const CODE_PAYMENT_DECLINED = "payment_declined";

export class PaymentDeclinedError extends APIError {
  constructor(readonly data: PaymentDeclined, body: string) {
    super(STATUS_PAYMENT_DECLINED, body);
    this.name = "PaymentDeclinedError";
  }
  retryable(): boolean {
    return true;
  }
}

export const STATUS_RATE_LIMITED = 429;

export class RateLimitedError extends APIError {
  constructor(readonly data: RateLimited, body: string) {
    super(STATUS_RATE_LIMITED, body);
    this.name = "RateLimitedError";
  }
}

export interface Client {
  createCharge(input: Account): Promise<Account>;
}

