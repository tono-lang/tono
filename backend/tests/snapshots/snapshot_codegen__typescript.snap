import { decodeBytes, encodeBytes } from "../bytes";
import { decodeI64, encodeI64 } from "../number";
import { APIError, Account, BankData, CODE_PAYMENT_DECLINED, CardData, HTTPCode, Method, PaymentDeclined, PaymentDeclinedError, RateLimited, RateLimitedError, STATUS_PAYMENT_DECLINED, STATUS_RATE_LIMITED, Status, Timestamp, TonoError } from "./types";

export function encodeAccount(value: Account): unknown {
  return {
    account_id: encodeI64(value.accountID),
    secret: encodeBytes(value.secret),
    tip: value.tip == null ? undefined : encodeI64(value.tip),
    status: encodeStatus(value.status),
    code: encodeHTTPCode(value.code),
    created: value.created,
    method: encodeMethod(value.method),
    counts: value.counts.map(([k, v]) => [k, v]),
  };
}

export function decodeAccount(raw: any): Account {
  return {
    accountID: decodeI64(raw.account_id),
    secret: decodeBytes(raw.secret),
    tip: raw.tip == null ? undefined : decodeI64(raw.tip),
    status: decodeStatus(raw.status),
    code: decodeHTTPCode(raw.code),
    created: (raw.created as Timestamp),
    method: decodeMethod(raw.method),
    counts: raw.counts.map(([k, v]: [any, any]) => [k, v]),
  };
}

export function encodeStatus(value: Status): string {
  return value;
}

export function decodeStatus(raw: string): Status {
  return raw as Status;
}

export function encodeHTTPCode(value: HTTPCode): number {
  return value;
}

export function decodeHTTPCode(raw: number): HTTPCode {
  return raw as HTTPCode;
}

export function encodeMethod(value: Method): unknown {
  switch (value.type) {
    case "card": return { type: "card", ...(encodeCardData(value as any) as object) };
    case "bank": return { type: "bank", ...(encodeBankData(value as any) as object) };
  }
  throw new Error("unknown variant");
}

export function decodeMethod(raw: any): Method {
  switch (raw.type) {
    case "card": return { type: "card", ...(decodeCardData(raw) as object) } as Method;
    case "bank": return { type: "bank", ...(decodeBankData(raw) as object) } as Method;
  }
  throw new Error("unknown variant");
}

export function encodeCardData(value: CardData): unknown {
  return {
    last4: value.last4,
  };
}

export function decodeCardData(raw: any): CardData {
  return {
    last4: raw.last4,
  };
}

export function encodeBankData(value: BankData): unknown {
  return {
    iban: value.iban,
    branch: value.branch == null ? undefined : value.branch,
  };
}

export function decodeBankData(raw: any): BankData {
  return {
    iban: raw.iban,
    branch: raw.branch == null ? undefined : raw.branch,
  };
}

export function decodePaymentDeclined(raw: any): PaymentDeclined {
