            tono_http_runtime::OutcomeKind::Success => {
decode_note(outcome.body.as_deref().unwrap_or(""))
            }
        }
    }
}

pub fn decode_save_note_error(status: u16, body: &str) -> TonoError {
    let value: serde_json::Value = match serde_json::from_str(body) {
        Ok(value) => value,
        Err(_) => return TonoError::Api(APIFailure::Undeclared(APIError { status, body: body.to_string() })),
    };
    let code = value.get("code").and_then(|v| v.as_str());
    if status == 529 && code == Some("overloaded") {
        if let Ok(data) = serde_json::from_value::<Overloaded>(value.clone()) {
            return TonoError::Api(APIFailure::Overloaded(data));
        }
    }
    TonoError::Api(APIFailure::Undeclared(APIError { status, body: body.to_string() }))
}

