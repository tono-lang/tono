use crate::support::{BoxFuture, ClientOptions, HttpError, HttpRequest, HttpResponse};

/// Renders a decoded JSON value the way the wire expects it in a path,
/// query, or header position. An integral float must not print a
/// trailing `.0`, and a 64-bit integer already rides as a string.
pub fn format_scalar(v: &serde_json::Value) -> String {
    match v {
        serde_json::Value::String(s) => s.clone(),
        serde_json::Value::Bool(b) => b.to_string(),
        serde_json::Value::Number(n) => {
            if let Some(i) = n.as_i64() {
                i.to_string()
            } else if let Some(u) = n.as_u64() {
                u.to_string()
            } else {
                n.as_f64().map(|f| f.to_string()).unwrap_or_default()
            }
        }
        serde_json::Value::Null => String::new(),
        other => other.to_string(),
    }
}

/// Percent-encode with the shared safe set (unreserved characters
/// only), matching the other targets' path and query escaping closely
/// enough for the wire contract.
fn percent_encode(s: &str) -> String {
    let mut out = String::with_capacity(s.len());
    for b in s.as_bytes() {
        if b.is_ascii_alphanumeric() || matches!(b, b'-' | b'_' | b'.' | b'~') {
            out.push(*b as char);
        } else {
            out.push_str(&format!("%{b:02X}"));
        }
    }
    out
}

/// One path segment's rendered value, percent-encoded.
pub fn percent_path(s: &str) -> String {
    percent_encode(s)
}

/// A path segment read off the input record: an absent or null value
/// substitutes empty rather than a literal "null".
pub fn path_part(v: Option<&serde_json::Value>) -> String {
    match v {
        Some(v) if !v.is_null() => percent_path(&format_scalar(v)),
        _ => String::new(),
    }
}

/// Overrides across casings: header names are case-insensitive, so a
/// bespoke "authorization" replaces a declared "Authorization" rather
/// than riding beside it.
pub fn set_header(headers: &mut std::collections::HashMap<String, String>, name: &str, value: String) {
    headers.retain(|k, _| !k.eq_ignore_ascii_case(name));
    headers.insert(name.to_string(), value);
}

/// Whether a header is already set under any casing: a caller-supplied
/// "Content-Type" must suppress the default rather than sit beside a
/// second "content-type".
pub fn has_header(headers: &std::collections::HashMap<String, String>, name: &str) -> bool {
    headers.keys().any(|k| k.eq_ignore_ascii_case(name))
}

/// Exponential backoff with full jitter: the constants are part of the
/// cross-runtime parity contract and must match every other target.
pub fn backoff_delay_ms(attempt: u32, random: f64) -> f64 {
    random * 2000f64.min(100.0 * 2f64.powi(attempt as i32))
}

/// Clamps the operation's `@retry` field, which the frontend types as
/// an integer scalar: a value below one means zero retries.
pub fn resolve_max_retries(value: i64) -> u32 {
    value.clamp(0, u32::MAX as i64) as u32
}

pub fn default_sleep() -> SleepFn {
    std::sync::Arc::new(|ms: f64| Box::pin(tokio::time::sleep(std::time::Duration::from_secs_f64(ms.max(0.0) / 1000.0))))
}

/// The jitter source behind the backoff, swappable like the sleep.
pub type RandomFn = std::sync::Arc<dyn Fn() -> f64 + Send + Sync>;

/// A "random-enough" `[0, 1)` value for backoff jitter, drawn from the
/// standard library's per-process random seed (no `rand` dependency;
/// jitter has no security requirement, and the parity harness always
/// pins the seam).
pub fn default_random() -> RandomFn {
    std::sync::Arc::new(|| {
        use std::collections::hash_map::RandomState;
        use std::hash::{BuildHasher, Hasher};
        let seed = RandomState::new().build_hasher().finish();
        (seed as f64 / u64::MAX as f64).min(0.999_999_999)
    })
}

/// Rejects an unusable transport configuration at construction time:
/// with the `reqwest` feature on, setting both slots is ambiguous;
/// with it off, the canonical slot is the only way to send at all.
#[cfg(feature = "reqwest")]
pub fn check_transport(options: &ClientOptions) -> Result<(), String> {
    if options.client.is_some() && options.transport.is_some() {
        return Err("Settings.client and Settings.transport are mutually exclusive: set the native slot or the canonical slot, not both".to_string());
    }
    Ok(())
}
