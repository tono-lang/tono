}

/// One attempt: the canonical transport when set, otherwise the native
/// `reqwest` stack (a fresh default client when none was configured).
pub async fn http_send(options: &ClientOptions, request: HttpRequest) -> Result<HttpResponse, HttpError> {
    if let Some(transport) = &options.transport {
        return transport(request).await;
    }
    native_send(options, request).await
}
#[cfg(feature = "reqwest")]
async fn native_send(options: &ClientOptions, request: HttpRequest) -> Result<HttpResponse, HttpError> {
    let client = options.client.clone().unwrap_or_default();
    let mut builder = client.request(request.method.parse::<reqwest::Method>()?, &request.url);
    for (name, value) in &request.headers {
        builder = builder.header(name.as_str(), value.as_str());
    }
    if let Some(body) = request.body {
        builder = builder.body(body);
    }
    let response = builder.send().await?;
    let status = response.status().as_u16();
    let headers: std::collections::HashMap<String, String> = response
        .headers()
        .iter()
        .map(|(k, v)| (k.as_str().to_lowercase(), v.to_str().unwrap_or_default().to_string()))
        .collect();
    let body = response.text().await?;
    Ok(HttpResponse { status, headers, body })
}
#[cfg(not(feature = "reqwest"))]
async fn native_send(_options: &ClientOptions, _request: HttpRequest) -> Result<HttpResponse, HttpError> {
    Err("no transport configured: enable the SDK crate's reqwest feature or set the canonical transport slot".into())
}

/// Bounds one attempt: the deadline covers the transport call only
/// (`tokio::time::timeout` drops the attempt's future, which is Rust's
/// native cancellation), so a transport that never answers still
/// times out. A non-positive deadline means no deadline.
pub async fn http_send_with_timeout(options: &ClientOptions, request: HttpRequest, timeout_ms: f64) -> Result<HttpResponse, HttpError> {
    if timeout_ms <= 0.0 {
        return http_send(options, request).await;
    }
    let deadline = std::time::Duration::from_secs_f64(timeout_ms / 1000.0);
    match tokio::time::timeout(deadline, http_send(options, request)).await {
        Ok(result) => result,
        Err(_elapsed) => Err(format!("attempt timed out after {timeout_ms}ms").into()),
    }
}

/// The sleep behind the retry loop's backoff, held as a swappable
/// `pub(crate)` field on the generated client rather than called
/// directly: the parity harness (a `#[cfg(test)]` module of the same
/// crate) pins it to record delays deterministically. Milliseconds,
/// matching the backoff math every target shares.
pub type SleepFn = std::sync::Arc<dyn Fn(f64) -> BoxFuture<'static, ()> + Send + Sync>;

