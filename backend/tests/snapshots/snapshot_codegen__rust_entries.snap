    pub async fn save_note(&self, input: Note) -> Result<Note, TonoError> {
        let record = serde_json::to_value(&input).map_err(|e| TonoError::Decode(DecodeError { path: "$".to_string(), expected: "input".to_string(), raw: e.to_string() }))?;
        let outcome = self.runtime.execute(save_note_descriptor(), &record, self.hooks.as_ref()).await
            .map_err(|cause| match cause.downcast::<TonoError>() {
                Ok(declared) => *declared,
                Err(other) => TonoError::Contract(ContractError { contract_name: "save_note".to_string(), cause: other }),
            })?;
        match outcome.kind {
            tono_http_runtime::OutcomeKind::Transport => Err(TonoError::Transport(TransportError { cause: outcome.cause.unwrap() })),
