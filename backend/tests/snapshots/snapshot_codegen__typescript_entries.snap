// ==== models.ts ====
export type Timestamp = string & { readonly __brand: "Timestamp" };

export type LocalDate = string & { readonly __brand: "LocalDate" };

export type Duration = string & { readonly __brand: "Duration" };

export interface Note {
  id: string;
  body: string;
}

export interface Overloaded {
  message: string;
}

export abstract class TonoError extends Error {
  retryable(): boolean {
    return false;
  }
}

export interface Violation {
  field: string;
  constraint: string;
  message: string;
}

export class ValidationError extends TonoError {
  constructor(readonly violations: Violation[]) {
    super("validation failed");
    this.name = "ValidationError";
  }
}

export class TransportError extends TonoError {
  constructor(readonly cause: unknown) {
    super("transport failure");
    this.name = "TransportError";
  }
}

export class DecodeError extends TonoError {
  constructor(readonly path: string, readonly expected: string, readonly raw: string) {
    super("response body did not match the declared schema");
    this.name = "DecodeError";
  }
}

export class ContractError extends TonoError {
  constructor(readonly contractName: string, readonly cause: unknown) {
    super("contract hook failed");
    this.name = "ContractError";
  }
}

export class APIError extends TonoError {
  constructor(readonly status: number, readonly body: string) {
    super(`api error ${status}`);
    this.name = "APIError";
  }
}

export class OverloadedError extends APIError {
  constructor(readonly data: Overloaded, body: string) {
    super(529, body);
    this.name = "OverloadedError";
  }
  retryable(): boolean {
    return true;
  }
}

// ==== models_serde.ts ====
import { CanonicalTransport, ClientOptions, WireDescriptor, execute } from "@tono/http-runtime-ts";
import { APIError, DecodeError, Duration, Note, Overloaded, OverloadedError, TonoError, TransportError, ValidationError, Violation } from "./notes";

export function encodeI64(v: bigint): string {
  return v.toString();
}

export function decodeI64(s: string): bigint {
  return BigInt(s);
}

export function encodeBytes(b: Uint8Array): string {
  return btoa(String.fromCharCode(...b));
}

export function decodeBytes(s: string): Uint8Array {
  return Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
}

export function encodeNote(value: Note): unknown {
  return {
    id: value.id,
    body: value.body,
  };
}

export function decodeNote(raw: any): Note {
  return {
    id: raw.id,
    body: raw.body,
  };
}

export function encodeOverloaded(value: Overloaded): unknown {
  return {
    message: value.message,
  };
}

export function decodeOverloaded(raw: any): Overloaded {
  return {
    message: raw.message,
  };
}

// Conf is a construction-only composition of the entry surface; it
// never crosses the wire.
export interface Conf {
  apiKey: string;
  region: string;
}

// Settings are the resolved construction values of the client entry,
// handed to the client_init hook before validation: bespoke code may
// overwrite any field (bespoke wins) and set transport through the slots.
// Exactly one transport slot may be set: fetch (native) or transport
// (canonical). headers are the base request headers (bespoke auth writes
// here); a declared @header wins only where nothing else set the name.
export interface Settings {
  apiKey: string;
  clientName: string;
  clientKey: string;
  endpointEnv: string;
  endpointVersion: string;
  endpointV1: string;
  endpointV2: string;
  endpoint: string;
  timeout: Duration;
  maxRetries: number;
  settings: Conf;
  fetch?: typeof fetch;
  transport?: CanonicalTransport;
  headers: Record<string, string>;
}

// ClientConfig carries the optional (@with) construction values of Client.
export interface ClientConfig {
  clientName?: string;
  timeout?: Duration;
  maxRetries?: number;
}

const saveNoteDescriptor: WireDescriptor = JSON.parse("{\"bindings\":[[\"id\",{\"kind\":\"label\"}],[\"body\",{\"kind\":\"body\"}]],\"endpoint\":[\"endpoint\"],\"errors\":[[529,\"notes#overloaded\",\"overloaded\",true]],\"http_method\":\"POST\",\"request_headers\":[[[{\"lit\":\"X-Client-Name\"}],{\"field\":[\"client_name\"]}]],\"response_bindings\":[],\"retry\":{\"max\":{\"ref\":\"max_retries\"}},\"success\":[[200,null]],\"timeout\":{\"ref\":\"timeout\"},\"uri\":\"/notes/{id}\"}");

// Client is the generated SDK client the client entry declares. The
// constructor takes the @arg values positionally and the @with values as a
// config object; construction resolves the declared sources, runs the
// client_init bridge, validates, and freezes the runtime options.
export class Client {
  readonly settings: Settings;
  private readonly options: ClientOptions;
  constructor(apiKey: string, config: ClientConfig = {}) {
    const s: Settings = { apiKey: "", clientName: "", clientKey: "", endpointEnv: "", endpointVersion: "", endpointV1: "", endpointV2: "", endpoint: "", timeout: "" as unknown as Duration, maxRetries: 0, settings: "" as unknown as Conf, headers: {} };
    s.apiKey = apiKey;
    let clientNameSet = false;
    if (config.clientName !== undefined) {
      s.clientName = config.clientName;
      clientNameSet = true;
    }
    if (!clientNameSet) {
      s.clientName = "demo";
    }
    s.clientKey = strUpperSnake((s.clientName).trim());
    s.endpointEnv = "ENDPOINT_" + s.clientKey + "_V2";
    let endpointVersionSet = false;
    if (!endpointVersionSet) {
      const v = readEnv("ENDPOINT_VERSION");
      if (v !== undefined) {
        s.endpointVersion = v;
        endpointVersionSet = true;
      }
    }
    if (!endpointVersionSet) {
      s.endpointVersion = "v2";
    }
    let endpointV1Why = "no source";
    {
      const v = readEnv("ENDPOINT");
      if (v !== undefined) {
        s.endpointV1 = v;
        endpointV1Why = "";
      } else {
        endpointV1Why = "env ENDPOINT: empty";
      }
    }
    let endpointV2Why = "no source";
    {
      const v = readEnv(s.endpointEnv);
      if (v !== undefined) {
        s.endpointV2 = v;
        endpointV2Why = "";
      } else {
        endpointV2Why = "env " + s.endpointEnv + ": empty";
      }
    }
    let endpointWhy = "";
    switch (s.endpointVersion) {
      case "v1": {
        if (endpointV1Why !== "") {
          endpointWhy = "endpoint_v1 <- " + endpointV1Why;
        } else {
          s.endpoint = s.endpointV1;
        }
        break;
      }
      case "legacy": {
        s.endpoint = "https://old.example.com";
        break;
      }
      default: {
        endpointWhy = "no source";
        {
          const v = readEnv("ENDPOINT_V2");
          if (v !== undefined) {
            s.endpoint = v;
            endpointWhy = "";
          } else {
            endpointWhy = "env ENDPOINT_V2: empty";
          }
        }
        if (endpointWhy !== "") {
        s.endpoint = "https://example.com";
        endpointWhy = "";
        }
        break;
      }
    }
    let timeoutSet = false;
    if (config.timeout !== undefined) {
      s.timeout = config.timeout;
      timeoutSet = true;
    }
    if (!timeoutSet) {
      s.timeout = "10s" as Duration;
    }
    let maxRetriesSet = false;
    if (config.maxRetries !== undefined) {
      s.maxRetries = config.maxRetries;
      maxRetriesSet = true;
    }
    if (!maxRetriesSet) {
      s.maxRetries = 3;
    }
    {
      const composed = {} as Conf;
      composed.apiKey = s.apiKey;
      let regionSet = false;
      if (!regionSet) {
        const v = readEnv("REGION");
        if (v !== undefined) {
          composed.region = v;
          regionSet = true;
        }
      }
      if (!regionSet) {
        composed.region = "us";
      }
      s.settings = composed;
    }
    if (s.endpoint === "") {
      throw new Error("endpoint <- " + (endpointWhy || "no value"));
    }
    const violations: Violation[] = [];
    if ([...s.apiKey].length < 1) {
      violations.push({ field: "api_key", constraint: "length", message: "api_key length must be >= 1" });
    }
    if (violations.length > 0) {
      throw new ValidationError(violations);
    }
    const values: Record<string, unknown> = {};
    values["api_key"] = s.apiKey;
    values["client_name"] = s.clientName;
    values["client_key"] = s.clientKey;
    values["endpoint_env"] = s.endpointEnv;
    values["endpoint_version"] = s.endpointVersion;
    if (endpointV1Why === "") {
      values["endpoint_v1"] = s.endpointV1;
    }
    if (endpointV2Why === "") {
      values["endpoint_v2"] = s.endpointV2;
    }
    if (endpointWhy === "") {
      values["endpoint"] = s.endpoint;
    }
    try {
      values["timeout"] = durationToMs(String(s.timeout));
    } catch {
      throw new Error(`timeout: invalid duration ${JSON.stringify(String(s.timeout))}`);
    }
    values["max_retries"] = s.maxRetries;
    values["settings.api_key"] = s.settings.apiKey;
    values["settings.region"] = s.settings.region;
    this.settings = s;
    this.options = { baseUrl: "", fetch: s.fetch, transport: s.transport, headers: s.headers, values };
  }

  async saveNote(input: Note): Promise<Note> {
    const outcome = await execute(saveNoteDescriptor, encodeNote(input), this.options);
    if (outcome.outcome === "transport") {
      throw new TransportError(outcome.cause);
    }
    if (outcome.outcome === "error") {
      throw decodeSaveNoteError(outcome.status, outcome.body);
    }
    try {
      return decodeNote(JSON.parse(outcome.body));
    } catch {
      throw new DecodeError("$", "Note", outcome.body);
    }
  }
}

export function decodeSaveNoteError(status: number, body: string): TonoError {
  let parsed: any;
  try {
    parsed = JSON.parse(body);
  } catch {
    return new APIError(status, body);
  }
  const code = typeof parsed === "object" && parsed !== null ? parsed["code"] : undefined;
  try {
    if (status === 529 && code === "overloaded") {
      return new OverloadedError(decodeOverloaded(parsed), body);
    }
  } catch {}
  return new APIError(status, body);
}

// readEnv treats an unset and an empty variable the same: empty means
// not set, per the declared-source contract.
function readEnv(name: string): string | undefined {
  const env = (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env;
  const v = env?.[name];
  return v === undefined || v === "" ? undefined : v;
}

// durationToMs parses the duration spelling shared across targets
// (Go's ParseDuration grammar: optional sign, bare zero, unit runs)
// into the runtime's millisecond values.
function durationToMs(v: string): number {
  let rest = v;
  let sign = 1;
  if (rest.startsWith("-")) {
    sign = -1;
    rest = rest.slice(1);
  } else if (rest.startsWith("+")) {
    rest = rest.slice(1);
  }
  if (rest === "0") {
    return 0;
  }
  const re = /(\d+(?:\.\d+)?)(ns|us|\u00b5s|ms|s|m|h)/gy;
  const unit: Record<string, number> = { ns: 1e-6, us: 1e-3, "\u00b5s": 1e-3, ms: 1, s: 1000, m: 60000, h: 3600000 };
  let total = 0;
  let consumed = 0;
  for (let m = re.exec(rest); m !== null; m = re.exec(rest)) {
    total += Number(m[1]) * unit[m[2]];
    consumed = re.lastIndex;
  }
  if (consumed !== rest.length || rest.length === 0) {
    throw new Error(`invalid duration ${JSON.stringify(v)}`);
  }
  return sign * total;
}

// strTransformWords splits a resolved value for the casing transforms:
// runs of spaces, hyphens, and underscores separate words.
function strTransformWords(s: string): string[] {
  return s.split(/[ _-]+/).filter((w) => w !== "");
}

function strUpperSnake(s: string): string {
  return strTransformWords(s).map((w) => w.toUpperCase()).join("_");
}
