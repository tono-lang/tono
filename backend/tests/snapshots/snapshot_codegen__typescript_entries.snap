      if (endpointV1Err !== undefined) {
        endpointErr = new ConfigError(`endpoint_v1 <- ${endpointV1Err.message}`, endpointV1Err);
      } else {
        s.endpoint = s.endpointV1;
      }
      break;
    }
    case "legacy": {
      s.endpoint = "https://old.example.com";
      break;
    }
    default: {
      if (endpointV2Err !== undefined) {
        endpointErr = new ConfigError(`endpoint_v2 <- ${endpointV2Err.message}`, endpointV2Err);
      } else {
