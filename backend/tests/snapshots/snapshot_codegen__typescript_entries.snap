    super(`api error ${status}`);
    this.name = "APIError";
  }
}

export class ConfigError extends TonoError {
  constructor(message: string) {
    super(message);
    this.name = "ConfigError";
  }
}

export class OverloadedError extends APIError {
  constructor(readonly data: Overloaded, body: string) {
    super(529, body);
