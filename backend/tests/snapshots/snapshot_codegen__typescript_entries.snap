    id: value.id,
    body: value.body,
  };
}

export function decodeNote(raw: any): Note {
  return {
    id: raw.id,
    body: raw.body,
  };
}

export function encodeOverloaded(value: Overloaded): unknown {
  return {
    message: value.message,
  };
}

export function decodeOverloaded(raw: any): Overloaded {
  return {
    message: raw.message,
  };
}

export function encodeCredentials(value: Credentials): unknown {
  return {
    token: value.token,
    account_id: value.accountID,
  };
}

export function decodeCredentials(raw: any): Credentials {
  return {
    token: raw.token,
    accountID: raw.account_id,
  };
}

// Conf is a construction-only composition of the entry surface; it
// never crosses the wire and is module-local (the SDK builds it).
interface Conf {
  apiKey: string;
  region: string;
}

