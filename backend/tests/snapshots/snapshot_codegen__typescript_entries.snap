      s.settings = composed;
    }

    let credsErr: ConfigError | undefined;
    const raw = readEnv("SERVICE_CREDENTIALS");
    if (raw !== undefined) {
      let parsed: unknown;
      try {
        parsed = JSON.parse(raw);
      } catch (e) {
        throw new ConfigError(`${"SERVICE_CREDENTIALS"}: ${String(e)}`);
      }
      if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
        throw new ConfigError(`${"SERVICE_CREDENTIALS"}: expected an object`);
      }
      const record = parsed as Record<string, unknown>;
      if (!("token" in parsed) || record["token"] === null) {
        throw new ConfigError(`${"SERVICE_CREDENTIALS"}: missing field token`);
      }
      if (!("account_id" in parsed) || record["account_id"] === null) {
        throw new ConfigError(`${"SERVICE_CREDENTIALS"}: missing field account_id`);
      }
      for (const key of Object.keys(parsed)) {
        if (!["token", "account_id"].includes(key)) {
          throw new ConfigError(`${"SERVICE_CREDENTIALS"}: unknown field ${key}`);
        }
      }
      if ("token" in parsed && typeof record["token"] !== "string") {
        throw new ConfigError(`${"SERVICE_CREDENTIALS"}: field token must be a string`);
      }
      if ("account_id" in parsed && typeof record["account_id"] !== "string") {
        throw new ConfigError(`${"SERVICE_CREDENTIALS"}: field account_id must be a string`);
      }
      const decoded = decodeCredentials(parsed);
      const invalid = validateCredentials(decoded);
      if (invalid) {
        throw invalid;
      }
      s.creds = decoded;
      credsErr = undefined;
    } else {
      credsErr = new ConfigError("env SERVICE_CREDENTIALS: empty");
    }

    let labelsErr: ConfigError | undefined;
    const raw = readEnv("SERVICE_LABELS");
    if (raw !== undefined) {
      let parsed: any;
      try {
        parsed = JSON.parse(raw);
      } catch (e) {
        throw new ConfigError(`${"SERVICE_LABELS"}: ${String(e)}`);
      }
      if (typeof parsed !== "object" || parsed === null || Array.isArray(parsed)) {
        throw new ConfigError(`${"SERVICE_LABELS"}: expected an object`);
      }
      for (const [key, val] of Object.entries(parsed)) {
        if (typeof val !== "string") {
          throw new ConfigError(`${"SERVICE_LABELS"}: field ${key} must be a string`);
        }
      }
      s.labels = Object.fromEntries(Object.entries(parsed).map(([k, v]: [string, any]) => [k, v])) as Record<string, string>;
      labelsErr = undefined;
    } else {
      labelsErr = new ConfigError("env SERVICE_LABELS: empty");
    }

    s.seg = seg;

    let bySegmentErr: ConfigError | undefined;
    if (labelsErr !== undefined) {
      bySegmentErr = new ConfigError(`labels <- ${labelsErr.message}`, labelsErr);
    } else {
      const bySegmentV = s.labels[s.seg];
      if (bySegmentV !== undefined) {
        switch (bySegmentV) {
        default: {
          s.bySegment = bySegmentV;
          break;
        }
        }
      } else {
        if (endpointErr !== undefined) {
          bySegmentErr = new ConfigError(`endpoint <- ${endpointErr.message}`, endpointErr);
        } else {
          s.bySegment = s.endpoint;
        }
      }
    }

    if (s.endpoint === "") {
      throw new ConfigError("endpoint <- " + (endpointErr ? endpointErr.message : "no value"), endpointErr);
    }

    const violations: Violation[] = [];
    if ([...s.apiKey].length < 1) {
      violations.push({ field: "api_key", constraint: "length", message: "api_key length must be >= 1" });
    }
    if (violations.length > 0) {
      throw new ValidationError(violations);
    }
    try {
      this.timeoutMs = durationToMs(String(s.timeout));
    } catch {
      throw new ConfigError(`timeout: invalid duration ${JSON.stringify(String(s.timeout))}`);
    }
    this.settings = s;
    this.options = { fetch: s.fetch, transport: s.transport, headers: s.headers };
    assertExclusiveTransport(this.options);
  }

  async saveNote(input: Note): Promise<Note> {
    const record = encodeNote(input) as unknown as Record<string, unknown>;

    const url = this.settings.endpoint + `/notes/${pathPart(record["id"])}`;

    const headers: Record<string, string> = {};
    setHeader(headers, "X-Client-Name", formatScalar(this.settings.clientName));
    for (const [k, v] of Object.entries(this.options.headers ?? {})) setHeader(headers, k, v);

    const body = JSON.stringify(input.body);
    if (!hasHeader(headers, "content-type")) headers["content-type"] = "application/json";

    const timeoutMs = this.timeoutMs;

    const maxRetries = resolveMaxRetries(this.settings.maxRetries);

    for (let attempt = 0; ; attempt++) {
      const request: HttpRequest = { method: "POST", url, headers: { ...headers }, body };

      let response: HttpResponse;
      try {
        response = await httpSendWithTimeout(this.options, request, timeoutMs);
      } catch (cause) {
        if (attempt < maxRetries) {
          await retryDelay(attempt);
          continue;
        }
        throw new TransportError(cause);
      }
      const outcome = response;

      if (response.status === 200) {
        try {
          return parseNote(outcome.body);
        } catch (path) {
          throw new DecodeError(path as string, "Note", outcome.body);
        }
      }

      const err = decodeSaveNoteError(outcome.status, outcome.body);
      if (attempt < maxRetries && err.retryable()) {
        await retryDelay(attempt);
        continue;
      }
      throw err;
    }
  }
}

export function decodeSaveNoteError(status: number, body: string): TonoError {
  let parsed: any;
  try {
    // A body that fails to parse falls straight to the fallback, which
    // carries the raw body as APIError.
    parsed = JSON.parse(body);
  } catch {
    return new APIError(status, body);
  }
  try {
    if (status === STATUS_OVERLOADED && parsed?.["code"] === CODE_OVERLOADED) {
      return new OverloadedError(decodeOverloaded(parsed), body);
    }
  } catch {}
  return new APIError(status, body);
}

// ==== typescript/notes/codec.ts ====
// Code generated by tono. DO NOT EDIT.

import { Credentials, Note, Overloaded } from "./types";

export function encodeNote(value: Note): unknown {
  return {
    id: value.id,
    body: value.body,
  };
}

export function decodeNote(raw: any): Note {
  return {
    id: raw.id,
    body: raw.body,
  };
}

export function decodeOverloaded(raw: any): Overloaded {
  return {
    message: raw.message,
  };
}

export function encodeCredentials(value: Credentials): unknown {
  return {
    token: value.token,
    account_id: value.accountID,
  };
}

export function decodeCredentials(raw: any): Credentials {
  return {
    token: raw.token,
    accountID: raw.account_id,
  };
}

// Conf is a construction-only composition of the entry surface; it
// never crosses the wire and is module-local (the SDK builds it).
interface Conf {
  apiKey: string;
  region: string;
}

/** The members Note's declared shape requires present. */
const noteRequiredFields = ["id", "body"] as const;

/**
 * Parses a Note from its wire JSON: every required member must be
 * present (a null value counts as absent) before the typed decode
 * runs. Throws the failed path (`$` for the whole body, `$.field` for
 * a missing member) as a plain string, for the caller to build its
 * own DecodeError.
 */
export function parseNote(raw: string): Note {
  let obj: any;
  try {
    obj = JSON.parse(raw);
  } catch {
    throw "$";
  }
  if (typeof obj !== "object" || obj === null || Array.isArray(obj)) {
    throw "$";
  }
  for (const field of noteRequiredFields) {
    if (!(field in obj) || obj[field] === null) {
      throw "$." + field;
    }
  }
  return decodeNote(obj);
}

