{
  "comment": "Cross-runtime behavior vectors for the HTTP runtimes' retry/timeout executor. Each runtime runs every vector through its canonical transport slot with random pinned to 0.5 and an instant, recording sleep. Script entries are consumed one per attempt: response returns that status/body, transport_failure fails the attempt, hang blocks until the per-attempt timeout fires. expect.attempts is the number of transport calls; expect.delays_ms are the backoff sleeps between attempts (random * min(2000, 100 * 2^retry)). A vector's optional declared_errors ([status, code|null, retryable] triples) stands in for a generated decode<Op>Error + retryable() pair: each harness builds a retryable(status, body) predicate from it (first status match with an agreeing code decides; a null code matches any body) and passes that to Execute/execute, exactly the shape the real compiler emits inline at each operation's call site. A vector with no declared_errors means no error response is ever retryable.",
  "vectors": [
    {
      "name": "no retry declared means one attempt, ever",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]]
      },
      "values": {},
      "input": {},
      "script": [{ "kind": "response", "status": 500, "body": "{}" }],
      "expect": { "outcome": "error", "status": 500, "body": "{}", "attempts": 1, "delays_ms": [] }
    },
    {
      "name": "transport failures retry until success",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 2 } }
      },
      "values": {},
      "input": {},
      "script": [
        { "kind": "transport_failure" },
        { "kind": "transport_failure" },
        { "kind": "response", "status": 200, "body": "{\"ok\":true}" }
      ],
      "expect": {
        "outcome": "success",
        "status": 200,
        "body": "{\"ok\":true}",
        "attempts": 3,
        "delays_ms": [50, 100]
      }
    },
    {
      "name": "a declared retryable error retries",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 3 } }
      },
      "declared_errors": [[429, "overloaded", true]],
      "values": {},
      "input": {},
      "script": [
        { "kind": "response", "status": 429, "body": "{\"code\":\"overloaded\"}" },
        { "kind": "response", "status": 200, "body": "{}" }
      ],
      "expect": { "outcome": "success", "status": 200, "body": "{}", "attempts": 2, "delays_ms": [50] }
    },
    {
      "name": "a declared non-retryable error does not retry",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 3 } }
      },
      "declared_errors": [[404, null, false]],
      "values": {},
      "input": {},
      "script": [{ "kind": "response", "status": 404, "body": "{}" }],
      "expect": { "outcome": "error", "status": 404, "body": "{}", "attempts": 1, "delays_ms": [] }
    },
    {
      "name": "an undeclared error status does not retry",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 3 } }
      },
      "values": {},
      "input": {},
      "script": [{ "kind": "response", "status": 500, "body": "{}" }],
      "expect": { "outcome": "error", "status": 500, "body": "{}", "attempts": 1, "delays_ms": [] }
    },
    {
      "name": "the code discriminator blocks retry when the non-retryable error matches",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 3 } }
      },
      "declared_errors": [
        [429, "overloaded", true],
        [429, "quota_exceeded", false]
      ],
      "values": {},
      "input": {},
      "script": [{ "kind": "response", "status": 429, "body": "{\"code\":\"quota_exceeded\"}" }],
      "expect": {
        "outcome": "error",
        "status": 429,
        "body": "{\"code\":\"quota_exceeded\"}",
        "attempts": 1,
        "delays_ms": []
      }
    },
    {
      "name": "the code discriminator allows retry when the retryable error matches",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 2 } }
      },
      "declared_errors": [
        [429, "overloaded", true],
        [429, "quota_exceeded", false]
      ],
      "values": {},
      "input": {},
      "script": [
        { "kind": "response", "status": 429, "body": "{\"code\":\"overloaded\"}" },
        { "kind": "response", "status": 429, "body": "{\"code\":\"overloaded\"}" },
        { "kind": "response", "status": 200, "body": "{}" }
      ],
      "expect": { "outcome": "success", "status": 200, "body": "{}", "attempts": 3, "delays_ms": [50, 100] }
    },
    {
      "name": "a null declared code matches any body, including a non-JSON one",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 1 } }
      },
      "declared_errors": [[503, null, true]],
      "values": {},
      "input": {},
      "script": [
        { "kind": "response", "status": 503, "body": "service melting" },
        { "kind": "response", "status": 200, "body": "{}" }
      ],
      "expect": { "outcome": "success", "status": 200, "body": "{}", "attempts": 2, "delays_ms": [50] }
    },
    {
      "name": "a declared code with a non-matching body does not retry",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 3 } }
      },
      "declared_errors": [[503, "unavailable", true]],
      "values": {},
      "input": {},
      "script": [{ "kind": "response", "status": 503, "body": "not json" }],
      "expect": { "outcome": "error", "status": 503, "body": "not json", "attempts": 1, "delays_ms": [] }
    },
    {
      "name": "exhausted retries return the last outcome",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 1 } }
      },
      "values": {},
      "input": {},
      "script": [{ "kind": "transport_failure" }, { "kind": "transport_failure" }],
      "expect": { "outcome": "transport", "attempts": 2, "delays_ms": [50] }
    },
    {
      "name": "the retry maximum resolves through a ref into the client values",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "ref": "max_retries" } }
      },
      "values": { "max_retries": 2 },
      "input": {},
      "script": [
        { "kind": "transport_failure" },
        { "kind": "transport_failure" },
        { "kind": "response", "status": 200, "body": "{}" }
      ],
      "expect": { "outcome": "success", "status": 200, "body": "{}", "attempts": 3, "delays_ms": [50, 100] }
    },
    {
      "name": "a ref that resolves to nothing disables retry",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "ref": "absent" } }
      },
      "values": {},
      "input": {},
      "script": [{ "kind": "transport_failure" }],
      "expect": { "outcome": "transport", "attempts": 1, "delays_ms": [] }
    },
    {
      "name": "a fractional retry maximum floors",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 2.5 } }
      },
      "values": {},
      "input": {},
      "script": [
        { "kind": "transport_failure" },
        { "kind": "transport_failure" },
        { "kind": "transport_failure" }
      ],
      "expect": { "outcome": "transport", "attempts": 3, "delays_ms": [50, 100] }
    },
    {
      "name": "backoff grows exponentially and caps",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 6 } }
      },
      "values": {},
      "input": {},
      "script": [
        { "kind": "transport_failure" },
        { "kind": "transport_failure" },
        { "kind": "transport_failure" },
        { "kind": "transport_failure" },
        { "kind": "transport_failure" },
        { "kind": "transport_failure" },
        { "kind": "response", "status": 200, "body": "{}" }
      ],
      "expect": {
        "outcome": "success",
        "status": 200,
        "body": "{}",
        "attempts": 7,
        "delays_ms": [50, 100, 200, 400, 800, 1000]
      }
    },
    {
      "name": "a success is never retried",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 3 } }
      },
      "values": {},
      "input": {},
      "script": [{ "kind": "response", "status": 200, "body": "{}" }],
      "expect": { "outcome": "success", "status": 200, "body": "{}", "attempts": 1, "delays_ms": [] }
    },
    {
      "name": "a timed-out attempt is a transport failure and retries",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "retry": { "max": { "lit": 1 } },
        "timeout": { "lit": 30 }
      },
      "values": {},
      "input": {},
      "script": [{ "kind": "hang" }, { "kind": "response", "status": 200, "body": "{}" }],
      "expect": { "outcome": "success", "status": 200, "body": "{}", "attempts": 2, "delays_ms": [50] }
    },
    {
      "name": "a timeout without retry surfaces as a transport outcome",
      "descriptor": {
        "http_method": "POST",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "timeout": { "ref": "timeout_ms" }
      },
      "values": { "timeout_ms": 30 },
      "input": {},
      "script": [{ "kind": "hang" }],
      "expect": { "outcome": "transport", "attempts": 1, "delays_ms": [] }
    },
    {
      "name": "the endpoint ref and declared headers resolve from the client values",
      "descriptor": {
        "http_method": "GET",
        "uri": "/notes/{.suffix}",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "endpoint": ["endpoint"],
        "request_headers": [
          [[{ "lit": "Authorization" }], { "template": [{ "lit": "Bearer " }, { "field": ["token"] }] }],
          [[{ "lit": "X-Client" }], { "field": ["client_name"] }],
          [[{ "lit": "X-Missing" }], { "field": ["gone"] }]
        ]
      },
      "values": { "endpoint": "https://acme.test", "token": "t0", "client_name": "demo", "suffix": "s 1" },
      "input": {},
      "script": [{ "kind": "response", "status": 200, "body": "{}" }],
      "expect": {
        "outcome": "success",
        "status": 200,
        "body": "{}",
        "attempts": 1,
        "delays_ms": [],
        "request": {
          "url": "https://acme.test/notes/s%201",
          "headers": { "Authorization": "Bearer t0", "X-Client": "demo" }
        }
      }
    },
    {
      "name": "an unresolved endpoint falls back to the caller base url",
      "descriptor": {
        "http_method": "GET",
        "uri": "/x",
        "bindings": [],
        "response_bindings": [],
        "success": [[200, null]],
        "endpoint": ["endpoint"]
      },
      "values": {},
      "input": {},
      "script": [{ "kind": "response", "status": 200, "body": "{}" }],
      "expect": {
        "outcome": "success",
        "status": 200,
        "body": "{}",
        "attempts": 1,
        "delays_ms": [],
        "request": { "url": "https://api.test/x" }
      }
    }
  ]
}
