{
  "name": "@tono/http-runtime-ts",
  "version": "0.0.0",
  "description": "Hand-written HTTP transport runtime for tono-generated TypeScript SDKs. Interprets the opaque wire descriptor: builds the request, performs the call, classifies the response. Contains no auth.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "qs": "^6.15.2"
  }
}
