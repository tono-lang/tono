// A third-party settings source library that is generic over the value it
// resolves: `Source[T]` in the real Go package. The `type` declaration below
// names the instantiation (the foreign "Source" name plus the tono argument
// it is monomorphized with), so the emitted Go names the concrete type
// argument instead of leaving it for the compiler to infer.
ext settingskit {
  go: "github.com/example/settingskit"
  ts: "@example/settingskit"
  rust: "settingskit"

  type env_source("Source", app_settings) {
    extern get(): app_settings {
      go {
        call: "Get"()
        ctx
      }
      ts { call: "get"() }
      rust { call: "get"() }
    }
  }

  extern new_env_source(service: string, region: string): env_source {
    go { call: "NewEnvSource"(service, region) }
    ts { call: "newEnvSource"(service, region) }
    rust { call: "new_env_source"(service, region) }
  }
}

struct app_settings {
  endpoint: string
  token: string
}

@doc("An SDK entry whose settings resolve from an external, generic source.")
pub struct client {
  service: string @env("SERVICE_NAME") @default("orders")
  region: string @arg

  source: settingskit.env_source @with = settingskit.new_env_source(.service, .region)

  op ping(): app_settings
    impl .source.get()
}

// The library is never installed for this test: `stub settingskit.new_env_source`
// hands construction a fake source, and `stub settingskit.env_source.get`
// answers the method the operation's own body calls, so the assertion proves
// the handle method's answer reached the operation's output.
test "the source's settings become the operation's output" {
  stub settingskit.new_env_source: settingskit.env_source {}
  stub settingskit.env_source.get: app_settings { endpoint: "https://x.test", token: "t0" }
  c: client { region: "us-east" }
  got: c.ping()
  expect got: app_settings { endpoint: "https://x.test", token: "t0" }
}
