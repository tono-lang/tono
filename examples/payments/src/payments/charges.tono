import payments.common

@doc("A small payments API that exercises the hard wire cases end to end.")
pub struct charge {
  id: uuid
  amount: i64 @range(min: 0)
  fee: u64 @deprecated("folded into amount")
  receipt: bytes
  currency: string @length(min: 3, max: 3)
  note: string?
  tags: []string
  metadata: map[string]string
  created: timestamp
  status: common.status
  method: common.payment_method
}

enum http_code { ok = 200, not_found = 404, error = 500 }

@doc("A page of results with an optional continuation cursor.")
struct page[t] {
  items: []t
  next_cursor: string?
}

@doc("The card issuer declined the charge.")
@status(402)
@errorCode("card_declined")
@retryable
struct card_declined {
  message: string
}

@doc("No charge exists for the requested id.")
@status(404)
struct not_found {
  message: string
}

@doc("The payments SDK entry: the construction surface and its operations.")
pub struct client {
  api_key: string @arg @length(min: 1)
  endpoint: string @env("PAYMENTS_ENDPOINT") @default("https://api.payments.example.com")
  timeout: duration @with @default("10s")
  max_retries: i32 @with @default(2)

  op create_charge(charge): charge
    @http(method: "POST", path: "/charges", endpoint: .endpoint)
    @header("X-API-Key", .api_key)
    @timeout(.timeout)
    @retry(.max_retries)
    @errors(card_declined, not_found)
}
