import tono.http
import tono.errors

// A segmented endpoint config: the client picks the endpoint for its own
// segment out of a map, falling back to the plain endpoint when the segment
// has no override. Indexing a map by another field's value resolves to an
// optional value (the key may not be there), so the match requires a `null`
// arm; the other arm reads the looked-up value back through `._`, narrowed
// to a plain string there since the `null` arm already covers absence.
pub struct client {
  by_segment: map[string]string @env("BY_SEGMENT")
  seg: string @env("SEGMENT") @default("prod")
  endpoint: string @env("ENDPOINT") @default("https://api.example.com")

  segmented_endpoint: string = match .by_segment[.seg] {
    null => .endpoint
    _ => ._
  }

  op ping(): pong @http(method: "GET", path: "/ping", endpoint: .segmented_endpoint)
}

struct pong { ok: bool }

test "a segment present in the map wins over the plain endpoint" {
  c: client { by_segment: { "prod": "https://prod.example.com" }, seg: "prod" }
  s: stub c.ping.http: http.response { status: 200, headers: {}, body: "{\"ok\":true}" }
  got: c.ping()
  expect got: pong { ok: true }
  expect s.requests: [http.request { method: "GET", path: "/ping", .. }]
}

test "a segment absent from the map falls back to the plain endpoint" {
  c: client { by_segment: { "staging": "https://staging.example.com" }, seg: "prod" }
  s: stub c.ping.http: http.response { status: 200, headers: {}, body: "{\"ok\":true}" }
  got: c.ping()
  expect got: pong { ok: true }
  expect s.requests: [http.request { method: "GET", path: "/ping", .. }]
}
