{
  "operation": "save_note",
  "settings": { "api_token": "t0" },
  "cases": [
    {
      "name": "stores the note and reports what the store recorded",
      "input": { "id": "n1", "body": "hello", "updated_at": "" },
      "expect": {
        "outcome": "ok",
        "value": { "id": "n1", "body": "hello", "updated_at": "saved-by-t0" }
      }
    },
    {
      "name": "a declared failure crosses the boundary typed and retryable",
      "input": { "id": "overload", "body": "hello", "updated_at": "" },
      "expect": {
        "outcome": "declared",
        "code": "overloaded",
        "retryable": true,
        "data": { "message": "the store is shedding load" }
      }
    },
    {
      "name": "an undeclared failure becomes a contract error naming the operation",
      "input": { "id": "boom", "body": "hello", "updated_at": "" },
      "expect": { "outcome": "contract", "contract": "save_note" }
    },
    {
      "name": "a constraint violation is caught before the store is reached",
      "input": { "id": "n2", "body": "", "updated_at": "" },
      "expect": { "outcome": "validation", "fields": ["body"] }
    }
  ]
}
