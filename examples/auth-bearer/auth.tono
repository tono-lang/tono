import tono.http
import tono.errors

@doc("A tiny API whose auth is bespoke: client_init sets the header from Settings.")
pub struct account {
  id: uuid
  email: string
}

@doc("The SDK entry: the token and endpoint resolve at construction.")
pub struct client {
  api_token: string @env("API_TOKEN")
  endpoint: string @env("AUTH_ENDPOINT") @default("https://api.example.com")

  op get_account(): account
    @http(method: "GET", path: "/account", endpoint: .endpoint)
}

// Auth is 100% bespoke (there is no built-in scheme). The client_init hook
// receives the resolved Settings (the entry's declared fields plus the
// transport slots) and writes the Authorization header once, at construction:
// the token comes off Settings, never read from the environment by hand.
// before_request stays available for per-request work (signing, refresh).
ext hook client_init {
  go: "ext/go/auth.go#ApplyBearer"
  ts: "ext/ts/auth.ts#applyBearer"
}

// Bespoke request work is exactly what generated round-trip checks cannot
// verify; the oracle sits outside the generator: with the transport stubbed,
// the request on the wire must carry the header the hook wrote.
test "the bearer header written by client_init reaches the wire" {
  c: client { api_token: "sk-123" }
  s: stub c.get_account.http: http.response {
    status: 200,
    headers: { "content-type": "application/json" },
    body: "{\"id\":\"5f3a0e6e-8f2a-4f7e-9c1d-2b4a6d8e0f12\",\"email\":\"ada@example.com\"}"
  }
  got: c.get_account()
  expect got: account { id: "5f3a0e6e-8f2a-4f7e-9c1d-2b4a6d8e0f12", email: "ada@example.com" }
  expect s.requests: [http.request { method: "GET", path: "/account", headers: { "authorization": "Bearer sk-123", .. }, .. }]
}

test "construction rejects an empty token" {
  c: client { api_token: "" }
  expect c: errors.contract { name: "client_init" }
}
