import tono.http
import tono.errors

@doc("A tiny API whose auth is bespoke: the bearer header is built entirely from declared fields.")
pub struct account {
  id: uuid
  email: string
}

@doc("The SDK entry: the token and endpoint resolve at construction, the header derives from the token.")
pub struct client {
  api_token: string @env("API_TOKEN") @length(min: 1)
  auth_header: string @format("Bearer {.api_token}")
  endpoint: string @env("AUTH_ENDPOINT") @default("https://api.example.com")

  @http(method: "GET", path: "/account", endpoint: .endpoint)
  @header("Authorization", .auth_header)
  op get_account(): account
}

// Auth is 100% bespoke (there is no built-in scheme), but this scheme needs
// no bespoke code at all: @format derives the header from the declared
// token, and @header attaches it to every request. No FFI, no ext block.
test "the bearer header derived from the token reaches the wire" {
  c: client { api_token: "sk-123" }
  s: stub c.get_account.http: http.response {
    status: 200,
    headers: { "content-type": "application/json" },
    body: "{\"id\":\"5f3a0e6e-8f2a-4f7e-9c1d-2b4a6d8e0f12\",\"email\":\"ada@example.com\"}"
  }
  got: c.get_account()
  expect got: account { id: "5f3a0e6e-8f2a-4f7e-9c1d-2b4a6d8e0f12", email: "ada@example.com" }
  expect s.requests: [http.request { method: "GET", path: "/account", headers: { "authorization": "Bearer sk-123", .. }, .. }]
}

test "construction rejects a missing token" {
  c: client { api_token: "" }
  expect c: errors.config { field: "api_token" }
}
