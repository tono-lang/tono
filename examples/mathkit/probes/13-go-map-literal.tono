// Capability 13: a map literal as a call argument. The library takes a
// collection keyed by name (FromTable(entries map[string]T)); the call
// site passes `{ "answer": .answer, "other": 1.5 }`, the caller's own value
// for the map[string]float logical parameter, and the generated Go types
// the literal by that parameter (map[string]float64{...}).
ext mathkit {
  go: "tono-ext-fixture/mathkit"

  type calculator("Calculator", float) interface {
    extern compute(): float {
      go { call: "Compute"() ctx }
    }
  }

  extern from_table(entries: map[string]float): calculator {
    go { call: "FromTable"(entries) }
  }
}

pub struct client {
  answer: float @arg
  table: mathkit.calculator = mathkit.from_table({ "answer": .answer, "other": 1.5 })

  op value(): float
    impl .table.compute()
}
