// Capability 11: a static method as the constructor. The receiver of the
// call is the foreign type itself (FormulaCalculator::parse(expr)), an
// associated function of the concrete type rather than a free function; the
// callee spelling carries the whole path, qualified the way the crate is.
// The handle is stored behind the trait (capability 3), so the concrete
// type only ever appears as the receiver.
ext mathkit {
  rust { #(mathkit) }

  struct calculator {
    rust { #(Box<dyn Calculator<f64>>) }

    @async(rust)
    op compute(): float {
      rust { call: #(compute)() }
    }
  }

  op parse(expr: string): calculator {
    rust { call: #(FormulaCalculator::parse)(expr) }
  }
}

pub struct client {
  expr: string @arg
  formula: mathkit.calculator = mathkit.parse(.expr)

  op value(): float
    impl .formula.compute()
}
