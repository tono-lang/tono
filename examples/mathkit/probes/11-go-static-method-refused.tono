// Capability 11, the Go side: Go has no static method. A library exposes a
// package function for this (the plain `call:` shape, capability 6 and
// others), and a method expression (`pkg.Type.Method`) would compile into a
// call with a different meaning, so a binding with a type receiver has
// nothing correct to render as. The generator refuses it naming the site;
// this probe passes when generation is refused.
ext mathkit {
  go: "tono-ext-fixture/mathkit"

  type calculator("Calculator", float) interface {
    extern compute(): float {
      go { call: "Compute"() ctx }
    }
  }

  extern parse(expr: string): calculator {
    go { call: "FormulaCalculator"."Parse"(expr) }
  }
}

pub struct client {
  expr: string @arg
  formula: mathkit.calculator = mathkit.parse(.expr)

  op value(): float
    impl .formula.compute()
}
