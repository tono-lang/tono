// Capability 1: a foreign handle that is an interface, not a pointer to a
// struct. FromConstant returns Calculator[T] (an interface value); the
// storage type is spelled whole, without `*`, and the generated Go holds
// and passes the value as is.
ext mathkit {
  go { #(tono-ext-fixture/mathkit) }

  struct calculator {
    go { #(Calculator[float64]) }

    op compute(): float {
      go { call: #(Compute)(#(ctx context.Context)) }
    }
  }

  op from_constant(value: float): calculator {
    go { call: #(FromConstant[float64])(value) }
  }
}

pub struct client {
  base: float @arg
  constant: mathkit.calculator = mathkit.from_constant(.base)

  op value(): float
    impl .constant.compute()
}
