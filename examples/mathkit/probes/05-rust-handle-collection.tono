// Capability 5: a collection of handles as an argument. from_fallback takes
// Vec<Box<dyn Calculator<T>>>, the handles the caller already built. The
// handle is held behind the trait (the "interface" marker), so it is
// already stored as Box<dyn Calculator<f64>>; the variadic logical
// parameter's own list literal collects the two already-built handles into
// exactly that Vec.
ext mathkit {
  rust: "mathkit"

  type calculator(rust: "Calculator", float) interface {
    extern compute(): float {
      rust { call: "compute"() }
    }
  }

  extern from_constant(value: float): calculator {
    rust { call: "from_constant"(value) sync }
  }

  extern from_fallback(strategy: string, calcs: calculator variadic): calculator {
    rust { call: "from_fallback"(strategy, calcs) sync }
  }
}

pub struct client {
  base: float @arg
  other: float @arg
  primary: mathkit.calculator = mathkit.from_constant(.base)
  secondary: mathkit.calculator = mathkit.from_constant(.other)
  combined: mathkit.calculator = mathkit.from_fallback("first", [.primary, .secondary])

  op value(): float
    impl .combined.compute()
}
