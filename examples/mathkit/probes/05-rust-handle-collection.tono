// Capability 5: a collection of handles as an argument. from_fallback takes
// Vec<Box<dyn Calculator<T>>>, the handles the caller already built. The
// handle is stored as Box<dyn Calculator<f64>>, so the caller's list literal
// collects the two already-built handles into exactly that Vec.
ext mathkit {
  rust { #(mathkit) }

  struct calculator {
    rust { #(Box<dyn Calculator<f64>>) }

    @async(rust)
    op compute(): float {
      rust { call: #(compute)() }
    }
  }

  op from_constant(value: float): calculator {
    rust { call: #(from_constant)(value) }
  }

  op from_fallback(strategy: string, calcs: []calculator): calculator {
    rust { call: #(from_fallback)(strategy, calcs: #(Vec<Box<dyn Calculator<f64>>>)) }
  }
}

pub struct client {
  base: float @arg
  other: float @arg
  primary: mathkit.calculator = mathkit.from_constant(.base)
  secondary: mathkit.calculator = mathkit.from_constant(.other)
  combined: mathkit.calculator = mathkit.from_fallback("first", [.primary, .secondary])

  op value(): float
    impl .combined.compute()
}
