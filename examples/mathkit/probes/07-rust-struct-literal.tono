// Capability 7: a struct literal in call:. from_formula takes
// `FormulaOptions { precision: Option<u8> }` by value. The foreign form's
// Rust block names the type as the library spells it and the field as
// `Option<u8>`, so the literal renders as FormulaOptions { precision:
// Some(..) } from the bare u8 the logical parameter carries.
ext mathkit {
  rust { #(mathkit) }

  struct formula_options {
    precision: u8

    rust { #(FormulaOptions)  precision: #(Option<u8>) }
  }

  struct calculator {
    rust { #(Box<dyn Calculator<f64>>) }

    @async(rust)
    op compute(): float {
      rust { call: #(compute)() }
    }
  }

  op from_formula(expr: string, precision: u8): calculator {
    rust { call: #(from_formula)(expr: #(&str), formula_options { precision: precision }) }
  }
}

pub struct client {
  expr: string @arg
  precision: u8 @arg
  formula: mathkit.calculator = mathkit.from_formula(.expr, .precision)

  op value(): float
    impl .formula.compute()
}
