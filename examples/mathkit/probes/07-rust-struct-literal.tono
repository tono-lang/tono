// Capability 7: a struct literal in call:. from_formula takes
// FormulaOptions { precision: Option<u8> } by value. The literal is
// accepted by the frontend; Rust then needs the foreign struct spelled by
// its own name (FormulaOptions, not the tono-side rust_formula_options) and
// the value wrapped in Some(..), neither of which is expressible.
ext mathkit {
  rust: "mathkit"

  struct rust_formula_options { precision: u8 }

  type calculator("FormulaCalculator", float) {
    extern compute(): float {
      rust { call: "compute"() }
    }
  }

  extern from_formula(expr: string, precision: u8): calculator {
    rust { call: "from_formula"(expr, rust_formula_options { precision: precision }) }
  }
}

pub struct client {
  expr: string @arg
  precision: u8 @arg
  formula: mathkit.calculator = mathkit.from_formula(.expr, .precision)

  op value(): float
    impl .formula.compute()
}
