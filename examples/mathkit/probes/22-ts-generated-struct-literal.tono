// Capability 22: a literal of one of the module's own structs, built inline
// as the argument of a foreign call. remember<T> is instantiated over the
// generated `reading` (capability 14 passes the same value by reference to
// a field); here the value is written where it is passed, `reading { .. }`,
// and the emitter renders the object literal of the type it generates,
// never a foreign form: the struct declares no ts block because it is not
// the package's.
ext mathkit {
  ts { #(@tono-ext-fixture/mathkit) }

  struct memo {
    ts { #(Memo<.reading>) }

    op recall(): reading {
      ts { call: #(recall)() }
    }
  }

  op remember(seed: reading): memo {
    ts { call: #(remember)(seed) }
  }
}

struct reading {
  value: float
  label: string
}

pub struct client {
  value: float @arg
  label: string @arg
  memo: mathkit.memo = mathkit.remember(reading { value: .value, label: .label })

  op recall(): reading
    impl .memo.recall()
}
