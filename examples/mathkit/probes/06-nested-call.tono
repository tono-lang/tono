// Capability 6: a nested call in call:. The Go option is a value built by
// another call of the same library, WithPrecision(4), passed to
// FromFormula. This is the form the library actually has: a nested call's
// own arguments are literals or the extern's own logical parameters, never
// a construction-site field (there is no tono-level declaration for
// WithPrecision itself to type-check a caller's value against).
ext mathkit {
  go: "tono-ext-fixture/mathkit"

  type calculator("Calculator", float) interface {
    extern compute(): float {
      go { call: "Compute"() ctx }
    }
  }

  extern from_formula(expr: string): calculator {
    go { call: "FromFormula"(expr, "WithPrecision"(4)) }
  }
}

pub struct client {
  expr: string @arg
  formula: mathkit.calculator = mathkit.from_formula(.expr)

  op value(): float
    impl .formula.compute()
}
