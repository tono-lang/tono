// Capability 6: a nested call in call:. The Go option is a value built by
// another call of the same library, WithPrecision(4), passed to
// FromFormula's variadic slot. The nested call's own arguments are literals
// or the op's own logical parameters, never a construction-site field.
ext mathkit {
  go { #(tono-ext-fixture/mathkit) }

  struct calculator {
    go { #(Calculator[float64]) }

    op compute(): float {
      go { call: #(Compute)(#(ctx context.Context)) }
    }
  }

  op from_formula(expr: string): calculator {
    go { call: #(FromFormula[float64])(expr, #(WithPrecision)(4)) }
  }
}

pub struct client {
  expr: string @arg
  formula: mathkit.calculator = mathkit.from_formula(.expr)

  op value(): float
    impl .formula.compute()
}
