// Capability 13: a map literal as a call argument. The library takes a
// collection keyed by name (`new TableCalculator(entries: Record<string,
// T>)`); the call site passes `{ "answer": .answer, "other": 1.5 }`, the
// caller's own value for the map[string]float logical parameter, rendered
// as an object literal with quoted keys.
ext mathkit {
  ts: "@tono-ext-fixture/mathkit"

  type calculator("Calculator", float) {
    extern compute(): float {
      ts { call: "compute"() sync }
    }
  }

  extern from_table(entries: map[string]float): calculator {
    ts { call: "TableCalculator"(entries) new }
  }
}

pub struct client {
  answer: float @arg
  table: mathkit.calculator = mathkit.from_table({ "answer": .answer, "other": 1.5 })

  op value(): float
    impl .table.compute()
}
