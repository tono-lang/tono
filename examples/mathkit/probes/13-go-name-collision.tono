// Capability 13: a foreign type whose name collides with a generated one.
// The library exports `Client`, and so does every generated SDK entry; the
// spelling `#(*Client)` is the library's, and the emitted Go must keep the
// package selector on it whatever the module generates under the same name.
ext mathkit {
  go { #(tono-ext-fixture/mathkit) }

  struct session {
    go { #(*Client) }

    op ping(): string {
      go { call: #(Ping)() }
    }
  }

  op open(addr: string): session {
    go { call: #(Open)(addr) }
  }
}

pub struct client {
  addr: string @arg
  session: mathkit.session = mathkit.open(.addr)

  op ping(): string
    impl .session.ping()
}
