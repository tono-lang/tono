// Capability 8: construction by `new`. ConstantCalculator is a class; the
// `new` marker opts the binding into `new Symbol(args)` instead of a plain
// call.
ext mathkit {
  ts: "@tono-ext-fixture/mathkit"

  type calculator("Calculator", float) {
    extern compute(): float {
      ts { call: "compute"() sync }
    }
  }

  extern from_constant(value: float): calculator {
    ts { call: "ConstantCalculator"(value) new }
  }
}

pub struct client {
  base: float @arg
  constant: mathkit.calculator = mathkit.from_constant(.base)

  op value(): float
    impl .constant.compute()
}
