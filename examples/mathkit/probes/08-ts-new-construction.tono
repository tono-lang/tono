// Capability 8: construction by `new`. ConstantCalculator is a class; there
// is no `new` form, so the class is named as if it were a callable function
// and TypeScript refuses to call it without `new`.
ext mathkit {
  ts: "@tono-ext-fixture/mathkit"

  type calculator("Calculator", float) {
    extern compute(): float {
      ts { call: "compute"() sync }
    }
  }

  extern from_constant(value: float): calculator {
    ts { call: "ConstantCalculator"(value) }
  }
}

pub struct client {
  base: float @arg
  constant: mathkit.calculator = mathkit.from_constant(.base)

  op value(): float
    impl .constant.compute()
}
