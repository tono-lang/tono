// Capability 8: construction by `new`. ConstantCalculator is a class; the
// callee spelling carries the `new`, so the binding renders as
// `new ConstantCalculator(value)` instead of a plain call.
ext mathkit {
  ts { #(@tono-ext-fixture/mathkit) }

  struct calculator {
    ts { #(Calculator<number>) }

    op compute(): float {
      ts { call: #(compute)() }
    }
  }

  op from_constant(value: float): calculator {
    ts { call: #(new ConstantCalculator)(value) }
  }
}

pub struct client {
  base: float @arg
  constant: mathkit.calculator = mathkit.from_constant(.base)

  op value(): float
    impl .constant.compute()
}
