// Capability 11: a static method as the constructor. The receiver of the
// call is the foreign type itself (FormulaCalculator.parse(expr)), not a
// value the SDK holds; the callee spelling carries the whole path, and the
// type it names is what the generated module imports.
ext mathkit {
  ts { #(@tono-ext-fixture/mathkit) }

  struct calculator {
    ts { #(Calculator<number>) }

    op compute(): float {
      ts { call: #(compute)() }
    }
  }

  op parse(expr: string): calculator {
    ts { call: #(FormulaCalculator.parse)(expr) }
  }
}

pub struct client {
  expr: string @arg
  formula: mathkit.calculator = mathkit.parse(.expr)

  op value(): float
    impl .formula.compute()
}
