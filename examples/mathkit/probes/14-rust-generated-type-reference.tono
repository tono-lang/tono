// Capability 14: a generated type inside a foreign spelling. Memo<T> is
// generic over the caller's own type, here the tono struct `reading`: the
// spelling references it as `.reading`, the module's type by its own name,
// which the emitter renders as the type it generates and never qualifies
// by the crate; every other word of the spelling is the library's.
ext mathkit {
  rust { #(mathkit) }

  struct memo {
    rust { #(Memo<.reading>) }

    op recall(): reading {
      rust { call: #(recall)() }
    }
  }

  op remember(seed: reading): memo {
    rust { call: #(remember)(seed) }
  }
}

struct reading {
  value: float
  label: string
}

pub struct client {
  seed: reading @arg
  memo: mathkit.memo = mathkit.remember(.seed)

  op recall(): reading
    impl .memo.recall()
}
