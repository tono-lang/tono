// Capability 21 (TypeScript): a wrong binding inside the family that names
// a generated type. The handle spells `#(Memo<.reading>)`, so what its
// `recall()` answers is the module's own Reading; the method declares
// `string`. Before the check compiled beside the generated types, every
// binding of this family was reported unchecked and the mismatch was only
// found by tsc on a generated line; now the check refuses it on this file,
// at the method's span, before anything is generated (expected: check-red).
ext mathkit {
  ts { #(@tono-ext-fixture/mathkit) }

  struct memo {
    ts { #(Memo<.reading>) }

    op recall(): string {
      ts { call: #(recall)() }
    }
  }

  op remember(seed: reading): memo {
    ts { call: #(remember)(seed) }
  }
}

struct reading {
  value: float
  label: string
}

pub struct client {
  seed: reading @arg
  memo: mathkit.memo = mathkit.remember(.seed)

  op recall(): string
    impl .memo.recall()
}
