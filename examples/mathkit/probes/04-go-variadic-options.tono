// Capability 4: a variadic parameter. FromFormula(expr string, opts
// ...Option) takes functional options variadically; the value of one option
// is built by WithPrecision(digits). Neither the variadic slot nor the
// nested call (capability 6) is expressible, so the precision is passed
// positionally, the nearest form, which Go refuses.
ext mathkit {
  go: "tono-ext-fixture/mathkit"

  type calculator("Calculator", float) {
    extern compute(): float {
      go { call: "Compute"() ctx }
    }
  }

  extern from_formula(expr: string, precision: u8): calculator {
    go { call: "FromFormula"(expr, precision) }
  }
}

pub struct client {
  expr: string @arg
  precision: u8 @arg
  formula: mathkit.calculator = mathkit.from_formula(.expr, .precision)

  op value(): float
    impl .formula.compute()
}
