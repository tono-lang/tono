// Capability 4 (variadic parameter) and 6 (nested call in call:): the Go
// shape is FromFormula(expr, WithPrecision(4)), an option built by a
// nested call and passed through a variadic logical parameter. "option" has
// no methods of its own (WithPrecision is a free function, not one of its
// methods); the "interface" marker still fits, since a Go func value is
// exactly the "not a concrete struct held by pointer" shape it names.
ext mathkit {
  go: "tono-ext-fixture/mathkit"

  type calculator("Calculator", float) interface {
    extern compute(): float {
      go { call: "Compute"() ctx }
    }
  }

  type option interface {
  }

  extern from_formula(expr: string, opts: option variadic): calculator {
    go { call: "FromFormula"(expr, opts) }
  }
}

pub struct client {
  expr: string @arg
  formula: mathkit.calculator = mathkit.from_formula(.expr, ["WithPrecision"(4)])

  op value(): float
    impl .formula.compute()
}
