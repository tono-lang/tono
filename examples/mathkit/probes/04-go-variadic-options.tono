// Capability 4 (variadic parameter): FromFallback takes
// `calcs ...Calculator[T]`. The logical parameter is a collection; the Go
// binding spells what it crosses as, `...Calculator[float64]`, and the
// generated call spreads the caller's list into the variadic slot.
ext mathkit {
  go { #(tono-ext-fixture/mathkit) }

  struct calculator {
    go { #(Calculator[float64]) }

    op compute(): float {
      go { call: #(Compute)(#(ctx context.Context)) }
    }
  }

  op from_constant(value: float): calculator {
    go { call: #(FromConstant[float64])(value) }
  }

  op from_fallback(strategy: string, calcs: []calculator): calculator {
    go { call: #(FromFallback[float64])(strategy, calcs: #(...Calculator[float64])) }
  }
}

pub struct client {
  base: float @arg
  other: float @arg
  primary: mathkit.calculator = mathkit.from_constant(.base)
  secondary: mathkit.calculator = mathkit.from_constant(.other)
  combined: mathkit.calculator = mathkit.from_fallback("first", [.primary, .secondary])

  op value(): float
    impl .combined.compute()
}
