// Capability 3: several concrete types for one logical handle. In Rust
// from_constant returns ConstantCalculator<T> and from_series returns
// SeriesCalculator<T>, both implementing the Calculator<T> trait. The
// storage type is `Box<dyn Calculator<f64>>`, so each constructor's concrete
// value is boxed where it is built and the concrete types never need a tono
// name at all.
ext mathkit {
  rust { #(mathkit) }

  struct calculator {
    rust { #(Box<dyn Calculator<f64>>) }

    @async(rust)
    op compute(): float {
      rust { call: #(compute)() }
    }
  }

  op from_constant(value: float): calculator {
    rust { call: #(from_constant)(value) }
  }

  op from_series(values: []float): calculator {
    rust { call: #(from_series)(values: #(Vec<f64>)) }
  }
}

pub struct client {
  base: float @arg
  samples: []float @arg
  constant: mathkit.calculator = mathkit.from_constant(.base)
  series: mathkit.calculator = mathkit.from_series(.samples)

  op constant_value(): float
    impl .constant.compute()

  op series_value(): float
    impl .series.compute()
}
