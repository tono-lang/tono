// Capability 3: several concrete types for one logical handle. In Rust
// from_constant returns ConstantCalculator<T> and from_formula returns
// FormulaCalculator<T>, both implementing the Calculator<T> trait; one
// tono handle names one foreign type, so the second constructor cannot
// agree with the first.
ext mathkit {
  rust: "mathkit"

  struct rust_formula_options { precision: u8 }

  type calculator("ConstantCalculator", float) {
    extern compute(): float {
      rust { call: "compute"() }
    }
  }

  extern from_constant(value: float): calculator {
    rust { call: "from_constant"(value) }
  }

  extern from_formula(expr: string, precision: u8): calculator {
    rust { call: "from_formula"(expr, rust_formula_options { precision: precision }) }
  }
}

pub struct client {
  base: float @arg
  expr: string @arg
  precision: u8 @arg
  constant: mathkit.calculator = mathkit.from_constant(.base)
  formula: mathkit.calculator = mathkit.from_formula(.expr, .precision)

  op constant_value(): float
    impl .constant.compute()

  op formula_value(): float
    impl .formula.compute()
}
