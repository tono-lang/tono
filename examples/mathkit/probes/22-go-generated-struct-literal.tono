// Capability 22: a literal of one of the module's own structs, built inline
// as the argument of a foreign call. Remember[T] is instantiated over the
// generated `reading` (capability 14 passes the same value by reference to
// a field); here the value is written where it is passed, `reading { .. }`,
// and the emitter renders the literal of the type it generates, never a
// foreign form: the struct declares no go block because it is not the
// library's.
ext mathkit {
  go { #(tono-ext-fixture/mathkit) }

  struct memo {
    go { #(*Memo[.reading]) }

    op recall(): reading {
      go { call: #(Recall)(#(ctx context.Context)) }
    }
  }

  op remember(seed: reading): memo {
    go { call: #(Remember[.reading])(seed) }
  }
}

struct reading {
  value: float
  label: string
}

pub struct client {
  value: float @arg
  label: string @arg
  memo: mathkit.memo = mathkit.remember(reading { value: .value, label: .label })

  op recall(): reading
    impl .memo.recall()
}
