// Capability 9: a method synchronous in one target and asynchronous in the
// others. compute() is synchronous in TypeScript (no @async names ts) and
// answers a value, not a Promise. SeriesCalculator, like every constructor
// of the library, is a class reached with `new` (capability 8).
ext mathkit {
  ts { #(@tono-ext-fixture/mathkit) }

  struct calculator {
    ts { #(Calculator<number>) }

    op compute(): float {
      ts { call: #(compute)() }
    }
  }

  op from_series(values: []float): calculator {
    ts { call: #(new SeriesCalculator)(values: #(number[])) }
  }
}

pub struct client {
  samples: []float @arg
  series: mathkit.calculator = mathkit.from_series(.samples)

  op value(): float
    impl .series.compute()
}
