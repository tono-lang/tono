// Capability 12: a class reference as a call argument. The library takes
// the class itself (`instantiate(clazz: new () => Calculator<T>)`) and
// constructs on its own, so what the binding passes is a declared handle's
// name: `answer_calculator` resolves as a handle of this ext block, and the
// generated module imports and passes its class.
ext mathkit {
  ts { #(@tono-ext-fixture/mathkit) }

  struct calculator {
    ts { #(Calculator<number>) }

    op compute(): float {
      ts { call: #(compute)() }
    }
  }

  struct answer_calculator {
    ts { #(AnswerCalculator) }

    op compute(): float {
      ts { call: #(compute)() }
    }
  }

  op make(): calculator {
    ts { call: #(instantiate)(answer_calculator) }
  }
}

pub struct client {
  calc: mathkit.calculator = mathkit.make()

  op value(): float
    impl .calc.compute()
}
