// Capability 12, the Rust side: Rust has no type as a value. A library that
// lets the caller choose the implementation takes a type parameter
// (`instantiate::<T>()`), a different shape from an argument, so a binding
// passing a class reference has nothing correct to render as. The generator
// refuses it naming the site; this probe passes when generation is refused.
ext mathkit {
  rust { #(mathkit) }

  struct calculator {
    rust { #(Box<dyn Calculator<f64>>) }

    @async(rust)
    op compute(): float {
      rust { call: #(compute)() }
    }
  }

  struct answer_calculator {
    rust { #(AnswerCalculator) }

    @async(rust)
    op compute(): float {
      rust { call: #(compute)() }
    }
  }

  op make(): calculator {
    rust { call: #(instantiate)(answer_calculator) }
  }
}

pub struct client {
  calc: mathkit.calculator = mathkit.make()

  op value(): float
    impl .calc.compute()
}
