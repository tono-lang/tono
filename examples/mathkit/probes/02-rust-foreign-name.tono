// Capability 2: the foreign type name per language. In Go and TypeScript
// "Calculator" names the interface, while in Rust `Calculator` is a trait
// and this constructor returns the concrete `ConstantCalculator<T>`. The
// Rust block spells the concrete storage type whole, and `compute`, a trait
// method on it, is called through its path (`Calculator::compute`), which
// brings the trait into scope where the concrete type is held; holding the
// handle behind the trait instead (probe 03) is the other shape.
ext mathkit {
  rust { #(mathkit) }

  struct calculator {
    rust { #(ConstantCalculator<f64>) }

    @async(rust)
    op compute(): float {
      rust { call: #(Calculator::compute)() }
    }
  }

  op from_constant(value: float): calculator {
    rust { call: #(from_constant)(value) }
  }
}

pub struct client {
  base: float @arg
  constant: mathkit.calculator = mathkit.from_constant(.base)

  op value(): float
    impl .constant.compute()
}
