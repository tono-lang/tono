// The FFI bench. A fictional numeric library, "mathkit", declared with the
// shapes real libraries have: in Go the handle is an interface and options
// are variadic, in Rust every constructor returns a different concrete
// struct, in TypeScript every constructor is a class reached with `new` and
// compute() is synchronous. The three stand-in packages live under ext/;
// the numbered capabilities named in the comments are the rows of the table
// in README.md.
//
// Two rules carry the whole file:
//   1. #(...) is a foreign spelling, emitted verbatim. It is never text.
//   2. Everything specific to one language lives in that language's block.
//      Traits belong to tono; blocks belong to the boundary.
//
// The Go context is neither a spelling nor a tono reference: it is a
// position declaration. The emitter already binds `ctx context.Context` on
// every Go op, and the binding only says where it enters the foreign call;
// the type written there is checked against what the emitter generates.
ext mathkit {
  go { #(tono-ext-fixture/mathkit) }
  ts { #(@tono-ext-fixture/mathkit) }
  rust { #(mathkit) }

  // Capability 7 (struct literal in call:). A readable foreign form. Go does
  // not have it (it uses a functional option), so it declares no go block. A
  // field carries its own spelling when it differs from the tono type: in
  // Rust the field is Option<u8>, in tono it is u8.
  struct formula_options {
    precision: u8

    ts { #(FormulaOptions) }
    rust { #(FormulaOptions)  precision: #(Option<u8>) }
  }

  // Capabilities 1, 2 and 3 (handle that is an interface; foreign type per
  // language; several concrete types for one logical handle). An opaque
  // handle: no fields, only methods. Each target spells the whole STORAGE
  // type, which is what absorbs the Go interface (held by value, no `*`),
  // the Rust Box<dyn>, and a generic instantiation that differs per target.
  struct calculator {
    go { #(Calculator[float64]) }
    ts { #(Calculator<number>) }
    rust { #(Box<dyn Calculator<f64>>) }

    // Capability 9 (synchronous in one target, asynchronous in the others):
    // compute() is a future only in Rust; Go has no await and the TypeScript
    // of this library returns T, not Promise<T>. Absence of @async means
    // synchronous; naming a target without async (go) is an error.
    @async(rust)
    op compute(): float {
      go { call: #(Compute)(#(ctx context.Context)) }
      ts { call: #(compute)() }
      rust { call: #(compute)() }
    }
  }

  // Capability 8 (construction by `new`): the TypeScript constructors are
  // classes, and the callee spelling carries the `new`.
  op from_constant(value: float): calculator {
    go { call: #(FromConstant[float64])(value) }
    ts { call: #(new ConstantCalculator)(value) }
    rust { call: #(from_constant)(value) }
  }

  // Capability 6 (nested call in call:). Go builds the option by a nested
  // call; TypeScript and Rust by a struct literal. All three shapes are
  // written, each in the block of the target that uses it.
  @errors(invalid_expression)
  op from_formula(expr: string, precision: u8): calculator {
    go { call: #(FromFormula[float64])(expr, #(WithPrecision)(precision)) }
    ts { call: #(new FormulaCalculator)(expr, formula_options { precision: precision }) }
    rust { call: #(from_formula)(expr: #(&str), formula_options { precision: precision }) }
  }

  op from_series(values: []float): calculator {
    go { call: #(FromSeries[float64])(values: #([]float64)) }
    ts { call: #(new SeriesCalculator)(values: #(number[])) }
    rust { call: #(from_series)(values: #(Vec<f64>)) }
  }

  // Capabilities 4 and 5 (variadic parameter; collection of handles as an
  // argument). The logical parameter is a collection; each target spells
  // what it crosses as.
  op from_fallback(strategy: string, calcs: []calculator): calculator {
    go { call: #(FromFallback[float64])(strategy, calcs: #(...Calculator[float64])) }
    ts { call: #(new FallbackCalculator)(strategy, calcs: #(Calculator<number>[])) }
    rust { call: #(from_fallback)(strategy, calcs: #(Vec<Box<dyn Calculator<f64>>>)) }
  }

  // Capability 11 (static method): the receiver is the foreign type itself,
  // inside the spelling. Go has no static method and needs no refusal: it
  // writes the package function, which is how the library exposes it there.
  op parse(expr: string): calculator {
    go { call: #(FromFormula[float64])(expr) }
    ts { call: #(FormulaCalculator.parse)(expr) }
    rust { call: #(FormulaCalculator::parse)(expr) }
  }

  // Capability 12 (class reference): the class itself crosses.
  // `answer_calculator` resolves as a handle declared in this ext, not as a
  // logical parameter; a collision between the two is an error.
  struct answer_calculator {
    ts { #(AnswerCalculator) }

    op compute(): float {
      ts { call: #(compute)() }
    }
  }

  op instantiate(): calculator {
    ts { call: #(instantiate)(answer_calculator) }
  }
}

// The error is an ordinary tono struct. The language block says how each
// target recognises it and where each field comes from, once, not in every
// op that can raise it.
@doc("The library could not interpret the expression.")
@errorCode("code", "invalid_expression")
pub struct invalid_expression {
  message: string

  go { #(ErrParse)  message: #(Error()) }
  rust { #(Error::Parse)  message: #(to_string()) }
}

@doc("Three calculators of different shapes, two of them composed into a fallback, feeding two operations.")
pub struct client {
  base: float @arg
  expr: string @arg
  precision: u8 @arg
  samples: []float @arg

  constant: mathkit.calculator = mathkit.from_constant(.base)
  formula: mathkit.calculator = mathkit.from_formula(.expr, .precision)
  series: mathkit.calculator = mathkit.from_series(.samples)
  // Capability 10 (a handle composed and read separately): forwarding
  // `constant` and `formula` here hands them to the fallback, so no
  // operation below may read either of them again (single ownership,
  // affirmed by probes/10-ownership-refused.tono). `series` is only read,
  // never forwarded, so it stays readable.
  combined: mathkit.calculator = mathkit.from_fallback("first", [.constant, .formula])

  op combined_value(): float
    impl .combined.compute()

  op series_value(): float
    impl .series.compute()
}

// The declared tests stub every constructor and the handle method, so the
// generated suites run without the library; the gate then runs the SDK
// against the stand-in library for real (see scripts/check-ffi-bench.sh).
test "the composed handle answers the operation" {
  stub mathkit.from_constant: mathkit.calculator {}
  stub mathkit.from_formula: mathkit.calculator {}
  stub mathkit.from_series: mathkit.calculator {}
  stub mathkit.from_fallback: mathkit.calculator {}
  stub mathkit.parse: mathkit.calculator {}
  stub mathkit.calculator.compute: 4.5
  c: client { base: 1.5, expr: "2 * 3", precision: 2, samples: [1.0, 2.0, 3.0] }
  got: c.combined_value()
  expect got: 4.5
}

test "a handle that is only read answers its own operation" {
  stub mathkit.from_constant: mathkit.calculator {}
  stub mathkit.from_formula: mathkit.calculator {}
  stub mathkit.from_series: mathkit.calculator {}
  stub mathkit.from_fallback: mathkit.calculator {}
  stub mathkit.parse: mathkit.calculator {}
  stub mathkit.calculator.compute: 3.0
  c: client { base: 1.5, expr: "2 * 3", precision: 2, samples: [1.0, 2.0, 3.0] }
  got: c.series_value()
  expect got: 3.0
}
