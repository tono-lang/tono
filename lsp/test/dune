; Protocol-level regressions can only be caught against the real server loop,
; so these suites drive the built binary over a pipe: the transport and
; workspace behavior, and the binding check on save (against a stand-in
; `tono`), sharing one harness.

(tests
 (names server_test server_binding_test)
 (modules server_test server_binding_test server_harness)
 (libraries yojson unix alcotest)
 (deps ../tono_lsp.exe))

; The editor-side half of the FFI bench's same-verdict gate: drives the
