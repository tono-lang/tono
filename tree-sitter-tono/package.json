{
  "name": "tree-sitter-tono",
  "version": "0.0.0",
  "private": true,
  "description": "Tree-sitter grammar for the tono interface language (editor and GitHub syntax highlighting)",
  "main": "bindings/node",
  "files": [
    "grammar.js",
    "queries/*.scm",
    "src/**"
  ],
  "devDependencies": {
    "tree-sitter-cli": "^0.24.0"
  },
  "scripts": {
    "generate": "tree-sitter generate",
    "test": "tree-sitter test"
  },
  "tree-sitter": [
    {
      "scope": "source.tono",
      "file-types": ["tono"],
      "highlights": "queries/highlights.scm"
    }
  ]
}
